# SuriFleet — переменные окружения для docker-compose стека.
# Скопируйте в .env и ЗАМЕНИТЕ значения. Файл .env в git не коммитится.

# Пароль пользователя surifleet в PostgreSQL (БД surifleet)
POSTGRES_PASSWORD=surifleet_dev

# Root-учётка MinIO (логин от 3 символов, пароль от 8)
MINIO_ROOT_USER=surifleet
MINIO_ROOT_PASSWORD=surifleet_dev_minio
